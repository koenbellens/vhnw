#!/bin/sh
# Enable VHNW services + networking inside the live image.
set -e

systemctl enable vhnw-agent.service
systemctl enable vhnw-setpass.service
systemctl enable ssh.service
systemctl enable systemd-networkd.service
# systemd-resolved provides DNS; enable if present (don't fail the build if not).
systemctl enable systemd-resolved.service || true

# NOTE: DNS (/etc/resolv.conf) is set at boot by the agent service's
# ExecStartPre. live-build resets /etc/resolv.conf to an empty file during
# its own cleanup, so configuring it here does not survive into the image.

# Protect the config (contains the pool wallet/worker).
chmod 600 /etc/vhnw/config.json || true

# Make helper scripts executable.
chmod 755 /usr/local/sbin/vhnw-setpass.sh || true
